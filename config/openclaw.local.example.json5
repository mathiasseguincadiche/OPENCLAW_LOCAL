{
  // Exemple lisible uniquement. La source de vérité exécutable est générée par
  // scripts/26_render_openclaw_config.py à partir de config/v1/* et agents/*.
  // N'ajoutez jamais de clé OpenRouter ou de token Gateway dans ce fichier.
  gateway: {
    mode: "local",
    bind: "loopback",
  },
  models: {
    providers: {
      ollama: {
        baseUrl: "http://127.0.0.1:11434",
        apiKey: "ollama-local",
        api: "ollama",
        timeoutSeconds: 300,
        models: [
          { id: "qwen3.5:9b-q4_K_M", name: "qwen3.5:9b-q4_K_M", input: ["text", "image"], contextTokens: 8192, params: { num_ctx: 8192, keep_alive: "15m" } },
          { id: "gemma3:12b-it-q4_K_M", name: "gemma3:12b-it-q4_K_M", input: ["text", "image"], contextTokens: 8192, params: { num_ctx: 8192, keep_alive: "15m" } },
          { id: "qwen2.5-coder:14b-instruct-q4_K_M", name: "qwen2.5-coder:14b-instruct-q4_K_M", input: ["text"], contextTokens: 8192, params: { num_ctx: 8192, keep_alive: "15m" } },
        ],
      },
    },
  },
  agents: {
    defaults: {
      skipBootstrap: true,
      model: { primary: "ollama/qwen3.5:9b-q4_K_M", fallbacks: ["ollama/gemma3:12b-it-q4_K_M"] },
      imageModel: { primary: "ollama/qwen3.5:9b-q4_K_M", fallbacks: ["ollama/gemma3:12b-it-q4_K_M"] },
      pdfModel: { primary: "ollama/qwen3.5:9b-q4_K_M", fallbacks: ["ollama/gemma3:12b-it-q4_K_M"] },
    },
    // Le générateur remplit cette liste avec les 8 rôles et marque
    // chef-operations comme agent par défaut.
    list: [],
  },
  tools: {
    profile: "coding",
    fs: { workspaceOnly: true },
    exec: { mode: "ask", applyPatch: { workspaceOnly: true } },
    elevated: { enabled: false },
    web: {
      search: { enabled: true, provider: "parallel-free", maxResults: 8, timeoutSeconds: 30, cacheTtlMinutes: 15 },
      fetch: { enabled: true, maxChars: 20000, maxCharsCap: 20000, timeoutSeconds: 30 },
    },
  },
}
