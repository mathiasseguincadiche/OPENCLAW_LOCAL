{
  // Exemple : à adapter au runtime OpenClaw réellement installé.
  models: {
    mode: "merge",
    providers: {
      ollama: {
        baseUrl: "http://127.0.0.1:11434",
        apiKey: "ollama-local",
        api: "ollama",
        timeoutSeconds: 300,
      },
    },
  },
  agents: {
    defaults: {
      model: {
        primary: "ollama/qwen3.5:9b",
      },
    },
  },
}
